[
  {
    "name": "documentId",
    "type": "text",
    "label": "Document ID",
    "required": true,
    "help": "ID of the PDFGate document to encrypt."
  },
  {
    "name": "algorithm",
    "type": "select",
    "label": "Encryption algorithm",
    "default": "AES256",
    "options": [
      {
        "label": "AES-256 (recommended)",
        "value": "AES256"
      },
      {
        "label": "AES-128",
        "value": "AES128"
      }
    ]
  },
  {
    "name": "userPassword",
    "type": "text",
    "label": "User password",
    "help": "Password required to open the PDF. With AES-256 you must also set an owner password."
  },
  {
    "name": "ownerPassword",
    "type": "text",
    "label": "Owner password",
    "help": "Password that grants full control (changing permissions, removing restrictions). Required when the encryption algorithm is AES-256 and a user password is set; otherwise optional."
  },
  {
    "name": "disableEditing",
    "type": "boolean",
    "label": "Disable editing",
    "default": false
  },
  {
    "name": "disableCopy",
    "type": "boolean",
    "label": "Disable copy / extract",
    "default": false
  },
  {
    "name": "disablePrint",
    "type": "boolean",
    "label": "Disable printing",
    "default": false
  },
  {
    "name": "encryptMetadata",
    "type": "boolean",
    "label": "Encrypt metadata",
    "default": false
  },
  {
    "name": "metadata",
    "type": "array",
    "label": "Metadata",
    "help": "Custom key-value metadata stored with the document.",
    "spec": {
      "type": "collection",
      "label": "Metadata item",
      "spec": [
        {
          "name": "key",
          "type": "text",
          "label": "Key",
          "required": true
        },
        {
          "name": "value",
          "type": "text",
          "label": "Value",
          "required": true
        }
      ]
    },
    "labels": {
      "add": "Add a metadata item"
    }
  },
  {
    "name": "preSignedUrlExpiresIn",
    "type": "number",
    "label": "Pre-signed URL expiry (seconds)",
    "default": 3600,
    "help": "How long the returned fileUrl stays valid, between 60 and 86400 seconds (24 hours).",
    "validate": {
      "min": 60,
      "max": 86400
    }
  }
]
