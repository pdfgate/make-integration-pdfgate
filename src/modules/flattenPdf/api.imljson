{
  "url": "/forms/flatten",
  "method": "POST",
  "body": {
    "documentId": "{{parameters.documentId}}",
    "metadata": "{{toCollection(parameters.metadata, 'key', 'value')}}",
    "preSignedUrlExpiresIn": "{{parameters.preSignedUrlExpiresIn}}",
    "jsonResponse": true
  },
  "response": {
    "output": {
      "documentId": "{{body.id}}",
      "status": "{{body.status}}",
      "type": "{{body.type}}",
      "fileUrl": "{{body.fileUrl}}",
      "size": "{{body.size}}",
      "metadata": "{{body.metadata}}",
      "derivedFrom": "{{body.derivedFrom}}",
      "createdAt": "{{body.createdAt}}",
      "expiresAt": "{{body.expiresAt}}"
    }
  }
}
