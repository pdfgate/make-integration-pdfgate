{
  "url": "{{if(substring(connection.apiKey, 0, 5) = 'test_', 'https://api-sandbox.pdfgate.com', 'https://api.pdfgate.com')}}{{parameters.url}}",
  "method": "{{parameters.method}}",
  "type": "text",
  "qs": {
    "{{...}}": "{{toCollection(parameters.qs, 'key', 'value')}}"
  },
  "headers": {
    "{{...}}": "{{toCollection(parameters.headers, 'key', 'value')}}"
  },
  "body": "{{parameters.body}}",
  "response": {
    "output": {
      "statusCode": "{{statusCode}}",
      "headers": "{{headers}}",
      "body": "{{body}}"
    }
  }
}
