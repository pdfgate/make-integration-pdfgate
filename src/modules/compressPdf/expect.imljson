[
  {
    "name": "documentId",
    "type": "text",
    "label": "Document ID",
    "required": true,
    "help": "ID of the PDFGate document to compress."
  },
  {
    "name": "linearize",
    "type": "boolean",
    "label": "Linearize",
    "default": false,
    "help": "Linearize the PDF so the first page appears before the whole file downloads."
  },
  {
    "name": "metadata",
    "type": "array",
    "label": "Metadata",
    "help": "Custom key-value metadata stored with the document.",
    "spec": {
      "type": "collection",
      "label": "Metadata item",
      "spec": [
        {
          "name": "key",
          "type": "text",
          "label": "Key",
          "required": true
        },
        {
          "name": "value",
          "type": "text",
          "label": "Value",
          "required": true
        }
      ]
    },
    "labels": {
      "add": "Add a metadata item"
    }
  },
  {
    "name": "preSignedUrlExpiresIn",
    "type": "number",
    "label": "Pre-signed URL expiry (seconds)",
    "default": 3600,
    "help": "How long the returned fileUrl stays valid, between 60 and 86400 seconds (24 hours).",
    "validate": {
      "min": 60,
      "max": 86400
    }
  }
]
