{
  "temp": {
    "valid": "{{if(data.secret && lower(ifempty(headers.`x-pdfgate-signature`, '')), contains(lower(ifempty(headers.`x-pdfgate-signature`, '')), 'v1=' + sha256(substring(lower(ifempty(headers.`x-pdfgate-signature`, '')), 2, indexOf(lower(ifempty(headers.`x-pdfgate-signature`, '')), ',')) + '.' + createJSON(body), 'hex', data.secret)), false)}}"
  },
  "condition": "{{temp.valid}}",
  "respond": {
    "status": 200,
    "type": "json",
    "body": {
      "message": "OK"
    }
  },
  "output": "{{body}}"
}
